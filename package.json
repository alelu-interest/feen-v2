{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@react-three/fiber": "^9.8.2",
    "expo": "~58.0.25",
    "expo-asset": "~58.0.18",
    "expo-file-system": "~58.0.12",
    "expo-gl": "~58.0.4",
    "expo-haptics": "~58.0.8",
    "expo-notifications": "~58.1.9",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "nativo": "expo prebuild --platform ios --no-install && node scripts/fuori-da-icloud.mjs && cd ios && pod install",
    "iphone": "node scripts/fuori-da-icloud.mjs && npm run build:sede && expo run:ios --configuration Release --device",
    "simulatore": "node scripts/fuori-da-icloud.mjs && npm run build:sede && expo run:ios --configuration Release",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lezioni": "node scripts/lezioni.mjs",
    "build:sede": "node scripts/lezioni.mjs && node scripts/build-sede.mjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo"
  }
}
